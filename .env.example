# Environment variables — CLAUDE_CODE_BUILD_SPEC.md §17.4
#
# This file is COMMITTED and contains placeholders only. Never put a real key here.
# Copy to .env.local for development (.env.local is gitignored).
# Production values are set as platform secrets in Vercel, never committed.

# --- Supabase -----------------------------------------------------------------
# Local values are printed by `supabase status` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. NEVER imported into any file under app/ that ships to the client.
# Exactly three callers: cron routes, the import executor, and the user-provisioning
# Server Action -- the last only AFTER a server-side OWNER/ADMIN check (ADR-009).
# lib/supabase/admin.ts throws if it is loaded in a browser context.
SUPABASE_SERVICE_ROLE_KEY=

# Migrations, and the integration suite's connection to the database.
# Local default when running without Docker (ADR-018):
#   postgresql://postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# --- Email --------------------------------------------------------------------
RESEND_API_KEY=

# --- Cron ---------------------------------------------------------------------
# Bearer token required by every /api/cron/* route (§14.7).
CRON_SECRET=

# --- Application --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# Set to exactly 1 to load the DEMO / TRAINING dataset's banner on every screen
# (§6). LEAVE IT UNSET IN PRODUCTION. It is inlined at build time, so a change
# needs a rebuild, and any value other than "1" is off.
NEXT_PUBLIC_DEMO_MODE=

# Sets the Node timezone. NOTE: this does NOT affect the Postgres session timezone,
# which stays UTC. SQL date expressions must use (now() at time zone 'Asia/Kolkata')::date
# See /docs/SPEC_AUDIT.md B-10.
TZ=Asia/Kolkata

# --- Approved additions (M-28) ------------------------------------------------
# Required by §14, §19 and §21 but absent from §17.4. Approved 2026-08-19.

RESEND_FROM_EMAIL=            # verified sender domain -- no email sends without it

# CI only -- pipeline migrations (M-17)
SUPABASE_ACCESS_TOKEN=        # Supabase CLI auth
SUPABASE_PROJECT_REF=         # target project for `supabase migration up --linked`

# Testing. The RLS and E2E suites run AS THE RESTRICTED ROLE, never as OWNER (§23).
PLAYWRIGHT_BASE_URL=
TEST_SALESPERSON_EMAIL=
TEST_SALESPERSON_PASSWORD=
TEST_MANAGER_EMAIL=
TEST_MANAGER_PASSWORD=
TEST_OWNER_EMAIL=
TEST_OWNER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# --- NOT set here -------------------------------------------------------------
# The optional weekly pg_dump to AWS S3 (Mumbai ap-south-1) runs from a scheduled
# GitHub Actions workflow, not from the application. Its secrets --
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, AWS_BACKUP_BUCKET and a
# separate read-capable DATABASE_URL -- live in GitHub Actions only and never
# touch .env.local or Vercel. See /docs/DEPLOYMENT.md section 7.2.
#
# THIS FILE IS FOR DEVELOPMENT AND FOR THE HOSTED (Vercel + Supabase Cloud)
# DEPLOYMENT. The office server does not read it: self-hosting is configured in
# deploy/env/production.env, from deploy/env/production.env.example, and none of
# AWS, Vercel, Supabase Cloud or Resend is required there (ADR-033, §20).
# See /docs/DEPLOYMENT.md, "Self-hosting on the office server".
