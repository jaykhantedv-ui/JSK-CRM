# Keep the build context small and keep secrets out of the image entirely.
.git
.github
node_modules
.next
npm-debug.log*

# Secrets — these must never enter a build context, let alone an image layer.
.env
.env.*
!.env.example
# `.env*` above only matches the context root. deploy/env/production.env holds
# the database password, the JWT secret, the service-role key and the backup
# passphrase, and `COPY . .` in the builder stage would otherwise carry it into
# an image layer.
deploy/env/*.env
!deploy/env/*.env.example

# Not needed to build or run the application.
tests
playwright-report
test-results
coverage
docs
supabase/seed/dev-fixtures.sql
backups
*.md
!README.md
