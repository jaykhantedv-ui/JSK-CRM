# Nightly maintenance — dormancy sweep (§14.6)
#
# Schedule is UTC, matching vercel.json exactly so the office server and the
# hosted deployment fire at the same moment: *-*-* 20:30:00 UTC = 02:00 next day IST.
#
# Persistent=true runs a job that was missed because the server was off — a
# power cut at 02:00 must not silently skip the night's maintenance.

[Unit]
Description=JSK CRM timer: maintenance

[Timer]
OnCalendar=*-*-* 20:30:00
Persistent=true
# Twenty users on one server: a little jitter keeps two jobs off the same second.
RandomizedDelaySec=60
Unit=jsk-crm-cron@maintenance.service

[Install]
WantedBy=timers.target
