# New-enquiry SLA check — flags untouched new opportunities (§14.2)
#
# Schedule is UTC, matching vercel.json exactly so the office server and the
# hosted deployment fire at the same moment: *-*-* *:00:00 UTC = hourly IST.
#
# Persistent=true runs a job that was missed because the server was off — a
# power cut at 02:00 must not silently skip the night's maintenance.

[Unit]
Description=JSK CRM timer: new-opportunity-sla

[Timer]
OnCalendar=*-*-* *:00:00
Persistent=true
# Twenty users on one server: a little jitter keeps two jobs off the same second.
RandomizedDelaySec=60
Unit=jsk-crm-cron@new-opportunity-sla.service

[Install]
WantedBy=timers.target
