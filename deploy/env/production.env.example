# JSK CRM — office server configuration.
#
# Copy to deploy/env/production.env and fill in. That file is gitignored and
# MUST NEVER be committed: it holds the database password, the JWT secret and
# the service-role key.
#
#   cp deploy/env/production.env.example deploy/env/production.env
#   deploy/keygen.sh >> deploy/env/production.env     # generates the secrets
#
# Keep a printed copy of this file in the business safe alongside the backup
# passphrase. Without JWT_SECRET, existing sessions and the backup are still
# fine — but the keys have to be regenerated and everyone signs in again.

# --- Secrets — generated by deploy/keygen.sh ---------------------------------
# POSTGRES_PASSWORD   the database superuser password
# JWT_SECRET          signs every session token; at least 32 characters
# ANON_KEY            public JWT, safe in a browser, signed with JWT_SECRET
# SERVICE_ROLE_KEY    ADMIN JWT — server-side only, never in a browser (§7)
# CRON_SECRET         bearer token the scheduled jobs present (§14.7)
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
CRON_SECRET=

# --- Addresses ---------------------------------------------------------------
# ONE ORIGIN serves both the CRM and Supabase. nginx routes /auth/v1, /rest/v1
# and /storage/v1 to the Supabase containers and everything else to the
# application, so PUBLIC_URL and PUBLIC_SUPABASE_URL are normally the SAME value.
#
#   LOCAL (this server only, no Cloudflare):
#     PUBLIC_URL=http://localhost
#     PUBLIC_SUPABASE_URL=http://localhost
#     SUPABASE_PORT=80
#
#   LAN (other machines in the office reach it by IP):
#     PUBLIC_URL=http://192.168.1.50
#     PUBLIC_SUPABASE_URL=http://192.168.1.50
#     SUPABASE_PORT=80
#
#   REMOTE (Cloudflare tunnel; point the tunnel at http://gateway:8000):
#     PUBLIC_URL=https://crm.example.com
#     PUBLIC_SUPABASE_URL=https://crm.example.com
#
# Both are BROWSER addresses. They must be reachable from a staff laptop, not
# merely from inside Docker.
PUBLIC_URL=http://localhost
PUBLIC_SUPABASE_URL=http://localhost

# Where SERVER-side code reaches Supabase, from inside the Docker network. Leave
# this alone: the public address above is not reachable from within the
# application container, and this is what makes server rendering work.
SUPABASE_INTERNAL_URL=http://gateway:8000

# --- Ports on the host -------------------------------------------------------
# SUPABASE_PORT is the ONLY port that needs to be reachable by a browser; it is
# the origin above. Set it to 80 for the http://localhost / http://<lan-ip> forms.
# It binds to 127.0.0.1 by default — see PUBLISH_HOST.
SUPABASE_PORT=80

# The application and PostgreSQL stay on the loopback interface. deploy/health.sh
# and deploy/run-cron.sh reach the app there; nothing else needs to.
APP_PORT=3000
POSTGRES_PORT=54322

# Which host interface the gateway binds to. 127.0.0.1 keeps everything on the
# server itself, which is right with a Cloudflare tunnel (it dials out) and for a
# single-machine trial. Set it to 0.0.0.0 ONLY to serve other machines on a
# trusted office LAN, and never on a VPS with a public IP and no firewall.
PUBLISH_HOST=127.0.0.1

# --- Demo / training ---------------------------------------------------------
# 1 loads and labels the synthetic training dataset. LEAVE THIS 0 IN PRODUCTION:
# it is what puts the DEMO / TRAINING DATA banner on every screen (§6).
DEMO_MODE=0

# --- Backups -----------------------------------------------------------------
# The passphrase that encrypts every dump. WRITE IT DOWN AND PUT IT IN THE SAFE.
# Lose it and the backups cannot be read — by anyone, including you (§10).
BACKUP_PASSPHRASE=
# Where daily backups are written, and the external drive they are copied to.
BACKUP_DIR=/var/backups/jsk-crm
BACKUP_EXTERNAL_DIR=/mnt/backup-drive/jsk-crm
BACKUP_RETENTION_DAYS=30

# --- Remote access (optional) ------------------------------------------------
# From the Cloudflare Zero Trust dashboard: Networks -> Tunnels -> your tunnel.
# Only needed when starting with `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Email — OPTIONAL INFRASTRUCTURE (§9) ------------------------------------
# The CRM works fully without any of this. /today, the dashboard, overdue,
# missing next action and the SLA flags never depend on mail being deliverable.
# Unset, the digests simply do not send. Nothing else changes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# GoTrue's own mail, used only for password-reset links. With no SMTP an ADMIN
# resets passwords from /settings instead, which is the expected path here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
